{
  "name": "inbox-assistant",
  "type": "cli",
  "description": "Query inbox-assistant state, content, and preferences.",
  "command": "aech-cli-inbox-assistant",
  "actions": [
    {
      "name": "prefs show",
      "description": "Show preferences.json.",
      "parameters": []
    },
    {
      "name": "prefs set",
      "description": "Set a top-level preference key.",
      "parameters": [
        {
          "name": "key",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "value",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "prefs keys",
      "description": "List valid top-level preference keys.",
      "parameters": []
    },
    {
      "name": "prefs unset",
      "description": "Remove a preference key.",
      "parameters": [
        {
          "name": "key",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "categories show",
      "description": "Show configured categories or defaults.",
      "parameters": []
    },
    {
      "name": "categories init-defaults",
      "description": "Initialize default categories if none are configured.",
      "parameters": []
    },
    {
      "name": "categories add",
      "description": "Add a category to the category configuration.",
      "parameters": [
        {
          "name": "name",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "color",
          "type": "option",
          "required": false,
          "description": "Category color name",
          "default": "blue"
        },
        {
          "name": "description",
          "type": "option",
          "required": false,
          "description": "Description for when to use this category",
          "default": ""
        },
        {
          "name": "flag_urgency",
          "type": "option",
          "required": false,
          "description": "Optional default flag urgency"
        }
      ]
    },
    {
      "name": "categories remove",
      "description": "Remove a configured category.",
      "parameters": [
        {
          "name": "name",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "categories update",
      "description": "Update an existing category.",
      "parameters": [
        {
          "name": "name",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "new_name",
          "type": "option",
          "required": false,
          "description": "Rename the category"
        },
        {
          "name": "color",
          "type": "option",
          "required": false,
          "description": "New category color"
        },
        {
          "name": "description",
          "type": "option",
          "required": false,
          "description": "New description"
        },
        {
          "name": "flag_urgency",
          "type": "option",
          "required": false,
          "description": "New default flag urgency"
        },
        {
          "name": "clear_flag_urgency",
          "type": "flag",
          "required": false,
          "description": "Remove the default flag urgency"
        }
      ]
    },
    {
      "name": "categories reset",
      "description": "Reset categories to the default set.",
      "parameters": []
    },
    {
      "name": "categories colors",
      "description": "List valid Outlook category colors.",
      "parameters": []
    },
    {
      "name": "email list",
      "description": "List ingested emails.",
      "parameters": [
        {
          "name": "limit",
          "type": "option",
          "required": false,
          "description": "Number of emails to list",
          "default": 20
        },
        {
          "name": "include_read",
          "type": "flag",
          "required": false,
          "description": "Include read emails"
        }
      ]
    },
    {
      "name": "email changes",
      "description": "List emails changed since a checkpoint.",
      "parameters": [
        {
          "name": "since",
          "type": "option",
          "required": false,
          "description": "Only emails updated after this ISO timestamp"
        },
        {
          "name": "limit",
          "type": "option",
          "required": false,
          "description": "Maximum changed emails to return",
          "default": 100
        },
        {
          "name": "include_read",
          "type": "flag",
          "required": false,
          "description": "Include read emails"
        }
      ]
    },
    {
      "name": "email get",
      "description": "Get a single email plus attachment manifests.",
      "parameters": [
        {
          "name": "message_id",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "email thread",
      "description": "Get all emails in a thread plus attachment manifests.",
      "parameters": [
        {
          "name": "conversation_id",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "limit",
          "type": "option",
          "required": false,
          "description": "Maximum messages to return",
          "default": 200
        }
      ]
    },
    {
      "name": "attachment list",
      "description": "List attachment manifests.",
      "parameters": [
        {
          "name": "email_id",
          "type": "option",
          "required": false,
          "description": "Filter to a specific email"
        },
        {
          "name": "status_filter",
          "type": "option",
          "required": false,
          "description": "Filter by extraction status"
        },
        {
          "name": "limit",
          "type": "option",
          "required": false,
          "description": "Number of attachments to list",
          "default": 50
        }
      ]
    },
    {
      "name": "attachment meta",
      "description": "Get attachment manifest metadata.",
      "parameters": [
        {
          "name": "attachment_id",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "attachment text",
      "description": "Get extracted text for an attachment.",
      "parameters": [
        {
          "name": "attachment_id",
          "type": "argument",
          "required": true,
          "description": ""
        }
      ]
    },
    {
      "name": "attachment fetch",
      "description": "Resolve or copy a stored attachment blob.",
      "parameters": [
        {
          "name": "attachment_id",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "output",
          "type": "option",
          "required": false,
          "description": "Optional output path to copy the attachment to"
        }
      ]
    },
    {
      "name": "search",
      "description": "Search emails, attachments, and facts using unified search.",
      "parameters": [
        {
          "name": "query",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "limit",
          "type": "option",
          "required": false,
          "description": "Number of results to return",
          "default": 20
        },
        {
          "name": "mode",
          "type": "option",
          "required": false,
          "description": "Search mode: hybrid, fts, or vector",
          "default": "hybrid"
        },
        {
          "name": "facts",
          "type": "flag",
          "required": false,
          "description": "Include facts in search",
          "default": true
        }
      ]
    },
    {
      "name": "ask",
      "description": "Ask inbox-assistant in natural language with grounded retrieval.",
      "parameters": [
        {
          "name": "query",
          "type": "argument",
          "required": true,
          "description": ""
        },
        {
          "name": "max_results",
          "type": "option",
          "required": false,
          "description": "Maximum matched emails to return",
          "default": 5
        }
      ]
    },
    {
      "name": "dbpath",
      "description": "Get the absolute path to the inbox database.",
      "parameters": []
    },
    {
      "name": "sync-status",
      "description": "Show per-folder sync checkpoints.",
      "parameters": []
    },
    {
      "name": "stats",
      "description": "Show mailbox corpus statistics.",
      "parameters": []
    }
  ],
  "documentation": {
    "usage": "aech-cli-inbox-assistant <command> [options]",
    "examples": [
      "aech-cli-inbox-assistant email list --limit 10",
      "aech-cli-inbox-assistant email get <message-id>",
      "aech-cli-inbox-assistant attachment text <attachment-id>",
      "aech-cli-inbox-assistant ask 'remember that email about budget?'",
      "aech-cli-inbox-assistant search 'budget' --limit 10"
    ]
  }
}
